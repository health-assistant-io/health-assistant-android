<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Health Connect read permissions (Phase A of health-connect-sync plan) -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Phase J — expanded Health Connect types -->
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Phase B.4 app-lock: BiometricPrompt (face/fingerprint). The permission
         is "normal" protection (no runtime prompt needed) but must be declared
         for the biometric API to enroll. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Health Connect package visibility (API 30+) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <!-- Phase A documents: needed so PackageManager.queryIntentActivities
             can find a viewer for a tapped document (PDF / image / etc.) on
             Android 11+ package-visibility. Without this the app sees zero
             candidates and falls back to "No viewer" even when WPS / Drive /
             the system viewer are installed. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".HAApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthAssistant">
        <!-- WorkManager expedited foreground service (Android 14+ foregroundServiceType). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- Per-app language persistence below Android 13 (AppCompatDelegate). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.HealthAssistant.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open in app" deep link from the web UI (plan §2.6): healthassistant://connect?base_url=…&integration_id=…&api_secret=… -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="healthassistant" android:host="connect" />
            </intent-filter>
        </activity>

        <!--
          Health Connect app recognition (required so the HC permission gateway
          honors our permission requests). HC looks for an activity handling
          ACTION_SHOW_PERMISSIONS_RATIONALE (API < 34) and, on Android 14+,
          VIEW_PERMISSION_USAGE in the HEALTH_PERMISSIONS category. Without these
          the installed HC app cancels the request immediately (granted=[]). Both
          aliases route to MainActivity (a dedicated rationale screen can replace
          this later).
        -->
        <activity-alias
            android:name="PermissionRationaleActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Phase A documents: FileProvider so the app can hand a freshly
          downloaded document (PDF / image) to the system viewer via
          Intent(ACTION_VIEW) + FLAG_GRANT_READ_URI_PERMISSION. Without a
          FileProvider, exposing a file:// URI raises
          FileUriExposedException on API 24+. The granted scope is
          cache-path `documents/` (see @xml/file_paths).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Phase I (medication reminders): handles the "Mark as taken" / "Snooze
          15 min" notification actions. Internal-only (exported=false) — the
          app never accepts these broadcasts from other apps.
        -->
        <receiver
            android:name=".work.MedicationReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.LatestVitalsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_latest_vitals_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/latest_vitals_widget_info" />
        </receiver>

        <!--
          M4 (widgets): the Single metric (2x1) widget + its configuration
          activity. The config activity must be exported — the launcher (a
          different app) starts it when the widget is placed.
        -->
        <receiver
            android:name=".widget.SingleMetricRingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_ring_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_metric_ring_widget_info" />
        </receiver>
        <activity
            android:name=".widget.SingleMetricRingWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.HealthAssistant">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- M4 (widgets): the Live heart rate (4x2) widget. -->
        <receiver
            android:name=".widget.LiveHeartRateWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_hr_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/live_heart_rate_widget_info" />
        </receiver>

        <!--
          Phase I (push): the UnifiedPush receiver. Must be exported so the
          user-chosen distributor app (ntfy, Gotify, …) can deliver the
          endpoint + message broadcasts. The intent filters are the UnifiedPush
          v1 spec contract.
        -->
        <receiver android:name=".work.MobilePushReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>